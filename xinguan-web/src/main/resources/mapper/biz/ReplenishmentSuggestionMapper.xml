<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.coderman.business.mapper.ReplenishmentSuggestionMapper">

    <resultMap id="BaseResultMap" type="com.coderman.common.model.business.ReplenishmentSuggestion">
        <id column="id" property="id"/>
        <result column="suggestion_num" property="suggestionNum"/>
        <result column="snapshot_id" property="snapshotId"/>
        <result column="p_num" property="pNum"/>
        <result column="suggestion_type" property="suggestionType"/>
        <result column="suggested_quantity" property="suggestedQuantity"/>
        <result column="source_department" property="sourceDepartment"/>
        <result column="target_department" property="targetDepartment"/>
        <result column="supplier_id" property="supplierId"/>
        <result column="expected_delivery_days" property="expectedDeliveryDays"/>
        <result column="priority" property="priority"/>
        <result column="status" property="status"/>
        <result column="rule_version" property="ruleVersion"/>
        <result column="idempotent_key" property="idempotentKey"/>
        <result column="operator" property="operator"/>
        <result column="remark" property="remark"/>
        <result column="create_time" property="createTime"/>
        <result column="modified_time" property="modifiedTime"/>
    </resultMap>

    <!-- 通过幂等键查找建议单 -->
    <select id="findByIdempotentKey" resultMap="BaseResultMap">
        SELECT *
        FROM biz_replenishment_suggestion
        WHERE idempotent_key = #{idempotentKey}
        LIMIT 1
    </select>

</mapper>
