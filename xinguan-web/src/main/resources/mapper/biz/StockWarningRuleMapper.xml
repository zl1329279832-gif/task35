<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.coderman.business.mapper.StockWarningRuleMapper">

    <resultMap id="BaseResultMap" type="com.coderman.common.model.business.StockWarningRule">
        <id column="id" property="id"/>
        <result column="p_num" property="pNum"/>
        <result column="min_stock_days" property="minStockDays"/>
        <result column="near_expiry_days" property="nearExpiryDays"/>
        <result column="safety_stock" property="safetyStock"/>
        <result column="reorder_point" property="reorderPoint"/>
        <result column="version" property="version"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="modified_time" property="modifiedTime"/>
    </resultMap>

    <!-- 查找物资级别的活跃规则 -->
    <select id="findActiveRule" resultMap="BaseResultMap">
        SELECT *
        FROM biz_stock_warning_rule
        WHERE p_num = #{pNum}
          AND status = 0
        ORDER BY version DESC
        LIMIT 1
    </select>

    <!-- 查找全局默认规则 -->
    <select id="findGlobalRule" resultMap="BaseResultMap">
        SELECT *
        FROM biz_stock_warning_rule
        WHERE p_num IS NULL
          AND status = 0
        ORDER BY version DESC
        LIMIT 1
    </select>

</mapper>
